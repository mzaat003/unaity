# Copy this file to ".env" and paste in the keys you create by hand.
# You only need the ones you actually want to use — leave the rest blank.
# NEVER commit your real .env (it is gitignored).

# --- OpenRouter: one key -> hundreds of models (many free) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Google Gemini (generous free API tier) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Groq (free, very fast) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Ollama (local models, unlimited, no account) ---
# Install from https://ollama.com then run e.g. `ollama pull llama3.2`
# Leave URL as default if running locally.
OLLAMA_BASE_URL=http://localhost:11434

# Comma-separated priority order the router tries. First that is
# configured and succeeds wins; on rate-limit/error it falls to the next.
PROVIDER_ORDER=openrouter,groq,gemini,ollama

# Port for the HTTP server.
PORT=3000
