# Copy this file to ".env" and paste in the keys you create by hand.
# You only need the ones you actually want to use — leave the rest blank.
# NEVER commit your real .env (it is gitignored).

# --- OpenRouter: one key -> hundreds of models (many free) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: point at any OpenAI-compatible endpoint (default is OpenRouter).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Google Gemini (generous free API tier) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Groq (free, very fast) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: point at any OpenAI-compatible endpoint (default is Groq).
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Ollama (local models, unlimited, no account) ---
# Install from https://ollama.com then run e.g. `ollama pull llama3.2`.
# Opt-in: UNCOMMENT the line below to enable Ollama (only do this if it's
# actually installed and running, otherwise leave it off).
# OLLAMA_BASE_URL=http://localhost:11434

# Comma-separated priority order the router tries. First that is
# configured and succeeds wins; on rate-limit/error it falls to the next.
PROVIDER_ORDER=openrouter,groq,gemini,ollama

# Port for the HTTP server.
PORT=3000
